# Copy to backend/.env and edit. Never commit the real file.
# §24: API keys never live in source code — only here, only on this machine.

# ---- server
VF_HOST=127.0.0.1
VF_PORT=8756
VF_LOG_LEVEL=INFO

# ---- storage (defaults to backend/data)
# VF_DATA_DIR=C:/VisionField/data

# ---- model selection
# "auto" walks the candidate list and keeps the first adapter that really loads.
VF_REASONING_PROVIDER=auto
VF_DETECTOR_PROVIDER=auto
VF_CLASSIFIER_PROVIDER=auto
VF_OCR_PROVIDER=auto
VF_EMBEDDING_PROVIDER=auto
VF_STT_PROVIDER=auto
VF_TTS_PROVIDER=auto

VF_REASONING_MODEL_ID=qwen3_vl_2b_instruct
# Embedding alternates (§12): nomic_embed_text | minilm_v2
VF_EMBEDDING_MODEL_ID=nomic_embed_text
VF_DETECTOR_MODEL_ID=yolov11_det
VF_CLASSIFIER_MODEL_ID=efficientnet_b4
# Segmenter alternates (§3): yolov11_seg | sam2 | mobilesam
VF_SEGMENTER_MODEL_ID=yolov11_seg
# Tracker alternates (§3): edgetam | track_anything
VF_TRACKER_MODEL_ID=edgetam
VF_OCR_MODEL_ID=easyocr
VF_STT_MODEL_ID=whisper_base
VF_TTS_MODEL_ID=pipertts_en

# ONNX Runtime execution providers, highest priority first.
# QNNExecutionProvider is the Snapdragon NPU path and is only used when the
# installed onnxruntime build genuinely has it.
VF_ONNX_EXECUTION_PROVIDERS=["QNNExecutionProvider","CPUExecutionProvider"]
VF_QNN_BACKEND_PATH=QnnHtp.dll

# Set false to make the service refuse to answer at all when no real VLM is
# present, instead of falling back to the deterministic offline reasoner.
VF_ALLOW_HEURISTIC_REASONING=true

# ---- live mode budget (§8)
VF_LIVE_DETECT_INTERVAL_MS=700
VF_LIVE_OCR_INTERVAL_MS=1800
VF_LIVE_VLM_MIN_GAP_MS=2500
VF_LIVE_SCENE_CHANGE_THRESHOLD=0.28

# ---- web research (§16) — off by default, local-first
VF_WEB_SEARCH_ENABLED=false
VF_WEB_SEARCH_PROVIDER=none
VF_WEB_SEARCH_ENDPOINT=
VF_WEB_SEARCH_API_KEY=
